# Default — every reload revalidates with the origin, but the response
# can still be served from the in-memory cache during a single session.
/*
  Cache-Control: no-cache
  # SAMEORIGIN (not DENY): foreign sites still can't wrap us in their own
  # clickjacking iframe, but the Journal modal can legitimately embed
  # /daily-frame as a same-origin iframe.
  X-Frame-Options: SAMEORIGIN
  # Browser must honour the Content-Type we send; no MIME-sniffing tricks.
  X-Content-Type-Options: nosniff
  # When linking out, send the origin but not the full URL/path.
  Referrer-Policy: strict-origin-when-cross-origin
  # We don't use these device APIs anywhere; lock them down so no third-party
  # script (OneSignal, fonts) can quietly probe them.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # Force HTTPS for 1 year, including subdomains. Once a browser has seen
  # this header on shouli.de, it will refuse plain HTTP entirely.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Hashed assets — content-addressed by filename, safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Live status — stale up to 60s at the edge, fresh on origin.
/status.json
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

# Service worker must always be fresh.
/OneSignalSDKWorker.js
  Cache-Control: no-cache


# PWA manifests — short cache, rarely change.
/manifest.json
  Cache-Control: public, max-age=300
/manifest-eddie.json
  Cache-Control: public, max-age=300
/manifest-instagram.json
  Cache-Control: public, max-age=300
